# Copy to .env and fill in. NEVER commit .env - it is gitignored.
# Everything here has a working default except the broker credentials.

# ---- data source ---------------------------------------------------------
# simulated | fyers | angelone
DATA_PROVIDER=simulated

# Comma-separated. Leave blank to use the bundled default universe.
SYMBOLS=

# ---- Fyers (only if DATA_PROVIDER=fyers) ---------------------------------
# Fyers uses a browser OAuth redirect that cannot run headless. Generate the
# access token once, then export it. `python -m nse_screener.providers.fyers`
# prints the authorisation URL.
FYERS_CLIENT_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=
FYERS_ACCESS_TOKEN=

# ---- Angel One (only if DATA_PROVIDER=angelone) --------------------------
# ANGEL_TOTP_SECRET is the base32 seed from authenticator enrolment, NOT the
# six-digit code - that is derived at login time.
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# ---- screener ------------------------------------------------------------
MIN_LTP=30
MAX_LTP=500
# WARNING: 1,000,000 on both sides is far above typical NSE cash top-of-book
# depth and will match almost nothing live. Lower it (e.g. 5000) to see the
# pipeline work, or run with --relax-liquidity.
MIN_BID_QTY=1000000
MIN_ASK_QTY=1000000
MAX_SYMBOLS=200

# ---- indicators ----------------------------------------------------------
SMMA_FAST=20
SMMA_SLOW=120
MOMENTUM_WINDOW=5
VOLATILITY_WINDOW=20

# ---- data ----------------------------------------------------------------
# SMMA(120) needs >=120 bars before it means anything, so the default lookback
# is much larger than the 60 minutes in the brief.
BAR_INTERVAL_MIN=1
HISTORY_MINUTES=1500
MIN_BARS_REQUIRED=150
POLL_SECONDS=5
QUOTE_BATCH_SIZE=50
MAX_FORWARD_FILL=3

# ---- trading / labelling -------------------------------------------------
COST_BPS=10
SLIPPAGE_BPS=2
MAX_HOLD_MINUTES=240
ALLOW_SHORT=true

# ---- model ---------------------------------------------------------------
ML_ALGORITHM=random_forest
ACCEPT_THRESHOLD=0.55
ML_N_ESTIMATORS=300
ML_MAX_DEPTH=6
ML_MIN_ROWS=60

# ---- misc ----------------------------------------------------------------
LOG_LEVEL=INFO
DASHBOARD_REFRESH_SECONDS=15
